# ============================================================
# Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env — only .env.example goes to git.
# ============================================================

# Supabase project URL (found in: Supabase Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (found in: Supabase Dashboard → Project Settings → API)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — keep this secret, never expose on the client
# (found in: Supabase Dashboard → Project Settings → API → service_role)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Express server port
PORT=5000

# Node environment: development | production
NODE_ENV=development

# Frontend origin for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173
