# ============================================================
# Trackiyo Environment Variables Example
#
# Trackiyo uses separate environments for Backend and Frontend.
# Refer to the sections below, or copy the values into:
#   - backend/.env
#   - frontend/.env
#
# Never commit real secrets to Git.
# ============================================================

# ------------------------------------------------------------
# BACKEND (backend/.env)
# ------------------------------------------------------------

# Server port
PORT=5000

# Node environment: development | production
NODE_ENV=development

# Frontend origin for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Supabase project URL (Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (Supabase Dashboard -> Project Settings -> API)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (Supabase Dashboard -> Project Settings -> API)
# Keep secret, never expose to frontend
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Google Gemini API key for AI features (chat, daily plan, coaching)
# Get one at: https://aistudio.google.com/apikey
# If omitted, AI endpoints will gracefully use built-in heuristic fallbacks.
GEMINI_API_KEY=

# ------------------------------------------------------------
# FRONTEND (frontend/.env)
# ------------------------------------------------------------

# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# Supabase public credentials for client-side Auth and Realtime subscriptions
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
